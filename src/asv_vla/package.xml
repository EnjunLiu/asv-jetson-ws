<?xml version="1.0"?>
<package format="3">
  <name>asv_vla</name>
  <version>0.2.0</version>
  <description>Fail-closed modular VLA stack with a frozen language encoder.</description>
  <maintainer email="liuenjun1010@gmail.com">Enjun Liu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
